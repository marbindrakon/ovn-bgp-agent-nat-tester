# Local configuration — copy to local-config.env and fill in values.
# This file is sourced by load-test.sh, setup-test-infra.sh, and clear-dashboard.sh.
# Do NOT commit local-config.env — it is gitignored.

# API key for dashboard mutating endpoints (must match the k8s dashboard-api-key secret)
# Generate with: openssl rand -hex 32
DASHBOARD_API_KEY=
